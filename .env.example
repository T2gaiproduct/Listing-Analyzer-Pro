# Copy to .env on the server (never commit real secrets).
# API server (listing-auditor-api / PM2) reads these at runtime.

DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/listingauditor
PORT=8080
NODE_ENV=production

# Dropbox — Excel/CSV export image columns (optional)
# Long-lived setup: refresh token + app credentials.
# One-time: node scripts/dropbox-oauth-offline.mjs authorize | exchange <code>
DROPBOX_APP_KEY=your_dropbox_app_key
DROPBOX_APP_SECRET=your_dropbox_app_secret
DROPBOX_REFRESH_TOKEN=your_dropbox_refresh_token
DROPBOX_EXPORT_PREFIX=/ecommerce-guru/exports
# DROPBOX_ACCESS_TOKEN=  # optional dev only; expires in hours — do not use on staging/production
