# Copy to `.env` and fill in real values. Never commit `.env`.

# ─── Required ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (server-side only)
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/listingauditor

# API server port
PORT=8080

# Clerk auth (server) — from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Legacy OpenAI integration module boot (server-side only; real AI audits use Admin → AI Settings DB key)
AI_INTEGRATIONS_OPENAI_API_KEY=your_openai_api_key_or_boot_placeholder
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Frontend (Vite — exposed to the browser; public-safe values only) ───────
# Clerk publishable key (safe for client; never put CLERK_SECRET_KEY here)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Optional: Clerk proxy URL when using a tunnel / custom domain
# VITE_CLERK_PROXY_URL=https://your-domain.example/api/__clerk

# Optional dev-only: skip /admin/is-admin round-trip for listed Clerk user IDs (UI hint only; not a security boundary)
# VITE_ADMIN_USER_IDS=user_example1,user_example2

# Frontend dev server
# PORT=19145
# BASE_PATH=/

# ─── Server optional ──────────────────────────────────────────────────────────
# Comma-separated Clerk user IDs granted admin (server-side source of truth)
# ADMIN_USER_IDS=user_example1,user_example2

# Public app URL for emails and invite links
# APP_URL=https://your-domain.example
# PUBLIC_APP_URL=https://your-domain.example

# CORS / redirect allowlist (comma-separated origins)
# ALLOWED_ORIGINS=https://your-domain.example

# Amazon SP-API OAuth state signing (falls back to CLERK_SECRET_KEY if unset)
# AMAZON_OAUTH_STATE_SECRET=generate_a_long_random_string

# SMTP (optional; can also be configured in Admin → Email Settings)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=SellerLens <noreply@your-domain.example>
# EMAIL_REPLY_TO=support@your-domain.example
# EMAIL_NOTIFICATIONS_ENABLED=true

# Dev-only: allow test-email admin bootstrap on localhost
# ALLOW_DEV_ADMIN_BOOTSTRAP=true

# Serve built frontend from API process
# SERVE_FRONTEND=true
# FRONTEND_DIST=/path/to/artifacts/listing-auditor/dist/public

# Replit / Stripe sync (only when deployed on Replit)
# REPLIT_DOMAINS=your-app.replit.app
# REPLIT_CONNECTORS_HOSTNAME=
# REPLIT_DEPLOYMENT=0

# Logging
# LOG_LEVEL=info
# NODE_ENV=development
