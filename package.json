{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "db:sync-local": "bash scripts/sync-local-db.sh",
    "db:sync-local-from-production": "bash scripts/sync-local-from-production.sh",
    "db:sync-production": "bash scripts/sync-production-db.sh",
    "db:sync-default-agents": "pnpm --filter @workspace/db exec tsx ../../scripts/sync-default-agents.ts",
    "db:generate-schema": "bash scripts/generate-additive-schema-from-local.sh",
    "db:align-production-with-local": "bash scripts/align-production-with-local-schema.sh",
    "db:compare-production": "bash scripts/compare-db-to-local.sh",
    "test:plan-capabilities": "pnpm --filter @workspace/db exec tsx ../../scripts/test-plan-capabilities.mjs",
    "test:plan-workspaces": "pnpm --filter @workspace/db exec tsx ../../scripts/test-plan-workspaces-integration.mjs",
    "test:member-credit-notify": "pnpm --filter @workspace/db exec tsx ../../scripts/test-member-credit-notify.mjs",
    "test": "pnpm run test:plan-capabilities && pnpm run test:plan-workspaces && pnpm run test:member-credit-notify",
    "test:qa:smoke": "node scripts/qa/smoke-api.mjs",
    "test:qa:security": "node scripts/qa/security-api.mjs",
    "test:qa:integration": "node scripts/qa/integration-resilience.mjs",
    "test:qa:concurrency": "node scripts/qa/concurrency-rate-limit.mjs",
    "test:qa:load": "k6 run scripts/qa/load-healthz.k6.js"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "stripe": "^22.1.1",
    "stripe-replit-sync": "^1.0.0"
  }
}
